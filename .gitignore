# ---- 이 프로젝트 전용 ----
# 프로젝트 안에 격리 설치한 파이썬 패키지 (약 1GB)
vendor/
# 내려받은 모델 가중치 (약 341MB) — prepare_models.py 로 재생성
models/

# ---- 파이썬 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 가상환경 ----
.venv/
venv/
env/
ENV/

# ---- 비밀/인증 정보 ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---- 실행 중 생성되는 파일 ----
*.log
logs/
uploads/
tmp/
temp/
.cache/
*.pid

# ---- 모델/데이터 캐시 ----
.huggingface/
huggingface/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# ---- 테스트 이미지 ----
test_images/
testimg/
sample_images/
static/__test_*

# ---- 에디터 / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 테스트/커버리지 ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- GitHub Actions self-hosted runner ----
# 러너는 ~/actions-runner 에 설치해 저장소 밖에 두지만,
# 저장소 안에서 실행하거나 옮기는 경우에도 추적되지 않도록 함께 막는다.
actions-runner/
actions-runner-*.tar.gz
# 러너 등록/실행 중 생성되는 파일 (토큰·작업 디렉터리·진단 로그)
_work/
_diag/
.runner
.credentials
.credentials_rsaparams
.credentials_rsautotoken
.path
.service
svc.sh
runsvc.sh
*.runner
actions.runner.*.plist

# ---- 모델 평가 / 로컬 실험 ----
# 상위 디렉터리의 models/ vendor/ 를 가리키는 로컬 심볼릭 링크
# (gitignore 의 'models/' 는 디렉터리만 걸러서 심볼릭 링크는 따로 적어야 한다)
/models
/vendor
# 평가용 이미지와 내려받기 캐시 — 공개 데이터셋에서 스크립트로 재생성한다
eval/data/
eval/cache/
# 배포 검증 모니터링 로그 (러너 작업 디렉터리에서 생성, Artifacts 로 업로드)
monitor-logs/
*.monitor.jsonl
